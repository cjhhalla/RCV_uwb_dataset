<launch>
    <arg name="resolution"    default="0"/> <!-- 0: 1280x800, 1: 1280x720, 2: 640x480, 3: 640x360 -->
    <arg name="frame_rate_"    default="30"/>
    <arg name="exposure"      default="5"/>
    <arg name="gain"          default="50"/>
    <arg name="wb_blue"       default="152"/>
    <arg name="wb_red"        default="138"/>
    <arg name="auto_exposure" default="false"/>
    <arg name="show_image"    default="false"/>

    <node name="UWB" pkg="uwb" type="uwb_pub.py" output="screen">
        <!-- 시리얼 포트 파라미터 설정 -->
        <param name="serial_port" value="/dev/uwb_port" />
    </node>
    <node name="QGC" pkg="qgc" type="set_global_position_px4.py" output="screen">
    </node>
    <!-- cam config-->
    <group ns = "cam1">
    <node pkg="ocam" type="ocam" name="ocam"  output="screen">
      <param name="serial"        value="SN_35CA5022"/>
            <param name="resolution"    value="$(arg resolution)"/> <!-- 0: 1280x960, 1: 1280x720, 2: 640x480, 3: 640x360 -->
            <param name="frame_rate"    value="$(arg frame_rate_)"/>
            <param name="exposure"      value="$(arg exposure)"/>
            <param name="gain"          value="$(arg gain)"/>
            <param name="wb_blue"       value="$(arg wb_blue)"/>
            <param name="wb_red"        value="$(arg wb_red)"/>
            <param name="auto_exposure" value="$(arg auto_exposure)"/>
            <param name="show_image"    value="$(arg show_image)"/>

	</node>
    </group>

    <group ns = "cam2">
        <node pkg="ocam" type="ocam" name="cam2" args="manager" cwd="node" output="screen">
            <param name="serial"        value="SN_35CA5040"/>
            <param name="resolution"    value="$(arg resolution)"/> <!-- 0: 1280x960, 1: 1280x720, 2: 640x480, 3: 640x360 -->
            <param name="frame_rate"    value="$(arg frame_rate_)"/>
            <param name="exposure"      value="$(arg exposure)"/>
            <param name="gain"          value="$(arg gain)"/>
            <param name="wb_blue"       value="$(arg wb_blue)"/>
            <param name="wb_red"        value="$(arg wb_red)"/>
            <param name="auto_exposure" value="$(arg auto_exposure)"/>
            <param name="show_image"    value="$(arg show_image)"/>
            <param name="camera_frame_id" value="cam2"/>     
        </node>
	</group>
     <group ns = "cam3">
        <node pkg="ocam" type="ocam" name="cam3" args="manager" cwd="node" output="screen">
            <param name="serial"        value="SN_35CA5041"/>
            <param name="resolution"    value="$(arg resolution)"/> <!-- 0: 1280x960, 1: 1280x720, 2: 640x480, 3: 640x360 -->
            <param name="frame_rate"    value="$(arg frame_rate_)"/>
            <param name="exposure"      value="5"/>
            <param name="gain"          value="$(arg gain)"/>
            <param name="wb_blue"       value="$(arg wb_blue)"/>
            <param name="wb_red"        value="$(arg wb_red)"/>
            <param name="auto_exposure" value="$(arg auto_exposure)"/>
            <param name="show_image"    value="$(arg show_image)"/>
            <param name="camera_frame_id" value="cam3"/>
        </node>

        
     </group>
     <group ns = "cam4">
        <node pkg="ocam" type="ocam" name="cam4" args="manager" cwd="node" output="screen">
            <param name="serial"        value="SN_35CA5043"/>
            <param name="resolution"    value="$(arg resolution)"/> <!-- 0: 1280x960, 1: 1280x720, 2: 640x480, 3: 640x360 -->
            <param name="frame_rate"    value="$(arg frame_rate_)"/>
            <param name="exposure"      value="5"/>
            <param name="gain"          value="$(arg gain)"/>
            <param name="wb_blue"       value="$(arg wb_blue)"/>
            <param name="wb_red"        value="$(arg wb_red)"/>
            <param name="auto_exposure" value="$(arg auto_exposure)"/>
            <param name="show_image"    value="$(arg show_image)"/>
            <param name="camera_frame_id" value="cam4"/>
        </node>
      </group>








    <!-- imu type, default normal -->
    <arg name="type" default="normal" doc="type [normal, modbus]"/>

    <!-- imu python -->
    <node pkg="wit_ros_imu" type="wit_$(arg type)_ros.py" name="imu" output="screen">
        <param name="port"               type = "str"    value="/dev/imu_port"/>
        <param name="baud"               type = "int"    value="115200"/>
    </node>
    <!--mocap : qualisys -->
    <arg name="server_address" default="192.168.0.180"/>
    <arg name="server_base_port" default="22222"/>
    <arg name="frame_rate" default="0"/>
    <arg name="max_accel" default="10.0"/>
    <arg name="publish_tf" default="true"/>
    <arg name="track_6_dofs" default="true"/>
    <arg name="track_labeled_markers" default="false"/>
    <arg name="track_unlabeled_markers" default="false"/>
    <arg name="fixed_frame_id" default="map"/>
    <arg name="udp_port" default="0"
        doc="UDP port can be set to -1 to request a TCP stream,
        setting 0 requests a random port, any other positive value 
        requests that specific port" />
    <arg name="qtm_protocol_version" default="18"/>
    <node pkg="mocap_qualisys"
        type="mocap_qualisys_node"
        name="qualisys"
        output="screen">
        <param name="server_address" value="$(arg server_address)"/>
        <param name="server_base_port" value="$(arg server_base_port)"/>
        <param name="frame_rate" value="$(arg frame_rate)"/>
        <param name="max_accel" value="$(arg max_accel)"/>
        <param name="publish_tf" value="$(arg publish_tf)"/>
        <param name="track_6_dofs" value="$(arg track_6_dofs)"/>
        <param name="track_labeled_markers" value="$(arg track_labeled_markers)"/>
        <param name="track_unlabeled_markers" value="$(arg track_unlabeled_markers)"/>
        <param name="fixed_frame_id" value="$(arg fixed_frame_id)"/>
        <param name="udp_port" value="$(arg udp_port)"/>
        <param name="qtm_protocol_version" value="$(arg qtm_protocol_version)"/>
        <rosparam param="model_list">[]</rosparam>
        <remap from="qualisys/drone/pose" to="/mavros/vision_pose/pose"/>
    </node>


</launch>
